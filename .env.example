# Copy this file to `.env` and fill in the values.
# Variables declared here are NOT automatically loaded by Prisma.
# Add `import "dotenv/config";` to `prisma.config.ts`, or load them via the Prisma CLI with Bun.

# Database connection string (PostgreSQL).
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Better Auth Options
# 64+ char random secret used for signing tokens/sessions.
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# Base URL of your app.
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth Credentials (OPTIONAL).
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth Credentials (OPTIONAL).
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Admin email address.
ADMIN_EMAIL="admin@example.com"

# Resend API key for transactional email (OPTIONAL).
RESEND_API_KEY="re_your-resend-api-key"

# Sender identity used in outgoing emails (OPTIONAL).
EMAIL_FROM="Job Tracker App <verify@example.com>"
